<section class="sfo-alignment-content">
  <p class="sfo-target"><strong>{{playerName}}</strong> · {{floorName}}<small>{{sceneName}}</small></p>
  <p class="hint">{{localize "SFO.alignmentHint"}}</p>
  <div class="sfo-number-grid">
    <label>X (px)<input type="number" name="x" value="{{assignment.x}}" min="-1000000000" max="1000000000" step="any"></label>
    <label>Y (px)<input type="number" name="y" value="{{assignment.y}}" min="-1000000000" max="1000000000" step="any"></label>
    <label>{{localize "SFO.width"}} (px)<input type="number" name="width" value="{{assignment.width}}" min="1" max="10000000" step="any"></label>
    <label>{{localize "SFO.height"}} (px)<input type="number" name="height" value="{{assignment.height}}" min="1" max="10000000" step="any"></label>
  </div>
  <p class="sfo-unit-size" data-grid-size>{{grid.width}} × {{grid.height}} {{grid.units}}</p>
  <label class="sfo-form-row">{{localize "SFO.rotation"}} (°)<input type="number" name="rotation" value="{{assignment.rotation}}" min="-1000000000" max="1000000000" step="any"></label>
  <label class="sfo-form-row">{{localize "SFO.previewOpacity"}}<input type="range" name="previewOpacity" min="0.05" max="1" step="0.05" value="0.55"></label>
  <p class="sfo-warning">{{localize "SFO.previewOnly"}}</p>
  <div class="sfo-button-row"><button type="button" data-action="fit">{{localize "SFO.fitScene"}}</button><button type="button" data-action="reset">{{localize "SFO.reset"}}</button></div>
  <footer class="sfo-button-row"><button type="button" data-action="cancel">{{localize "SFO.cancel"}}</button><button type="button" class="sfo-primary" data-action="save"><i class="fa-solid fa-save"></i> {{localize "SFO.save"}}</button></footer>
</section>
